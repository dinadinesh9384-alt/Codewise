# Copy into the deployment secret/configuration manager. Never commit a populated env file.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=codewise.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://codewise.example.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_TRUST_X_FORWARDED_PROTO=true
DJANGO_SESSION_COOKIE_AGE=43200

DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=codewise
DJANGO_DB_USER=codewise
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=postgres.internal
DJANGO_DB_PORT=5432
DJANGO_DB_SSLMODE=verify-full
DJANGO_DB_CONN_MAX_AGE=60

CODEWISE_PRIVATE_REPOSITORY_STORAGE=/srv/codewise/private-repository-storage
CODEWISE_API_WORKFLOW_FACTORY=config.workflow_runtime.build_api_workflow_runtime
CODEWISE_LLM_POLICY_CONFIG=
CODEWISE_LLM_MODEL_CAPABILITIES=
CODEWISE_LANGGRAPH_CHECKPOINTS_ENABLED=false
CODEWISE_LOG_LEVEL=INFO
